{
  "name": "touchstone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"yarn dev:api\" \"yarn dev:web\"",
    "dev:api": "TOUCHSTONE_PORT=8081 tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "yarn build:web && yarn build:api",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.server.json && mkdir -p dist/server/chat && cp src/server/chat/prompt.md dist/server/chat/prompt.md",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.6.0",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "web-push": "^3.6.7",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
